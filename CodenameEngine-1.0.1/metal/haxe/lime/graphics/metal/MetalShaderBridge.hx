package lime.graphics.metal;

import haxe.ds.IntMap;
import lime._internal.backend.native.NativeCFFI;
import lime.graphics.metal.GLSLToMSL;
import lime.graphics.metal.MetalTypes.TranslateResult;
import lime.graphics.metal.ShaderAot;
import lime.graphics.opengl.GL;

/**
	Glue between Lime's GL entry points and the GLSL→MSL translator.

	`lime._internal.backend.native.NativeOpenGLRenderContext` is patched (see
	`metal/scripts/apply.sh`) with five one-line `#if metal` hooks that call into this
	class.  Nothing else in Lime / OpenFL / HaxeFlixel / Codename Engine changes:

	  createShader(type)        -> remember the stage
	  shaderSource(shader, src) -> translate GLSL to MSL, hand the MSL to native
	  bindAttribLocation(...)   -> remember the GL location of each attribute name
	  linkProgram(program)      -> push the attribute/uniform tables to the backend
	  deleteShader/deleteProgram-> drop bookkeeping

	Everything the engine renders - images, vector graphics and shaders - goes through
	`GL`, so routing these five calls is enough to move the whole renderer to Metal.
**/
@:access(lime._internal.backend.native.NativeCFFI)
class MetalShaderBridge
{
	/** shader id -> true when it is a vertex shader */
	static var shaderIsVertex:IntMap<Bool> = new IntMap();

	/** shader id -> translation result (attributes / uniforms / samplers) */
	static var shaderResults:IntMap<TranslateResult> = new IntMap();

	/** program id -> attribute name -> GL location, as requested by OpenFL */
	static var programAttributeLocations:IntMap<Map<String, Int>> = new IntMap();

	/** program id -> shader ids attached to it */
	static var programShaders:IntMap<Array<Int>> = new IntMap();

	/** set to true once the backend reported itself as Metal */
	public static var active(default, null):Bool = false;

	/** guards the one-time exit-report registration */
	static var aotReportHooked:Bool = false;

	public static function init():Void
	{
		active = true;
	}

	/**
		Registers the shader-AOT summary so it is printed once when the application exits.
		Env-gated detail is printed per shader by `ShaderAot`; the summary itself is one
		line and always printed because it is the proof that no runtime GLSL→MSL
		translation happened.
	**/
	static function ensureAotReport():Void
	{
		if (aotReportHooked) return;
		aotReportHooked = true;
		#if sys
		try
		{
			var app = lime.app.Application.current;
			if (app != null)
			{
				app.onExit.add(function(_) {
					Sys.println(ShaderAot.report());
				});
				return;
			}
		}
		catch (e:Dynamic) {}
		#end
		ShaderAot.info(ShaderAot.report());
	}

	// ------------------------------------------------------------------ hooks

	public static function onCreateShader(shader:Int, type:Int):Void
	{
		shaderIsVertex.set(shader, type == GL.VERTEX_SHADER);
	}

	public static function onDeleteShader(shader:Int):Void
	{
		shaderIsVertex.remove(shader);
		shaderResults.remove(shader);
	}

	/**
		Hands the GLSL that OpenFL assembled to the **build-time AOT shader cache**.

		Nothing is translated while the game runs: the source is hashed and looked up in
		`ShaderAotCache` (generated by `metal/scripts/gen_shader_aot.py`, which uses the
		very same `GLSLToMSL` at build time and is compiled into the app as a Haxe
		constant).  A cache miss is a loud error - the GLSL is *not* passed to the
		translator; see `ShaderAot.onMiss`.  `GLSLToMSL.runtimeCallCount` stays 0 and is
		printed in the exit summary (`[cne-aot] EXIT ... runtimeGlslToMslCalls=0`).
	**/
	public static function onShaderSource(shader:Int, source:String):String
	{
		ensureAotReport();

		var isVertex = shaderIsVertex.exists(shader) ? shaderIsVertex.get(shader) : true;

		var entry = ShaderAot.fetch(source, isVertex);
		if (entry == null)
		{
			// Cache miss: loud by construction.  `onMiss` only returns an entry when the
			// explicit `CNE_METAL_AOT_RUNTIME_TRANSLATE=1` escape hatch is enabled.
			entry = ShaderAot.onMiss(shader, source, isVertex);
			if (entry == null) return source;
		}

		shaderResults.set(shader, entry.result);

		// The .metallib is binary, but the shader upload channel is a String
		// (`glShaderSource` -> `lime_gl_shader_source`).  Base64 is safe there, and the
		// native side strips this marker line and keeps the bytes; bgfx then calls
		// `newLibraryWithData` instead of `newLibraryWithSource`.
		var code = entry.code;
		var hasMetallib = entry.metallib != null && entry.metallib.length > 0;
		if (hasMetallib)
		{
			code = "// [cne-mtll] " + entry.metallib + "\n" + code;
		}

		if (ShaderAot.isAudit())
		{
			ShaderAot.info('[cne-aot] shader id=' + shader + ' stage=' + ShaderAot.stage(isVertex)
				+ ' msl=AOT-cache bytes=' + entry.code.length
				+ ' load=' + (hasMetallib ? 'metallib' : 'source-compile')
				+ ' key=' + ShaderAot.hash(source, isVertex));
		}
		return code;
	}

	public static function onBindAttribLocation(program:Int, index:Int, name:String):Void
	{
		var map = programAttributeLocations.get(program);
		if (map == null)
		{
			map = new Map<String, Int>();
			programAttributeLocations.set(program, map);
		}
		map.set(name, index);
	}

	public static function onAttachShader(program:Int, shader:Int):Void
	{
		var list = programShaders.get(program);
		if (list == null)
		{
			list = [];
			programShaders.set(program, list);
		}
		if (list.indexOf(shader) < 0) list.push(shader);
	}

	public static function onDeleteProgram(program:Int):Void
	{
		programAttributeLocations.remove(program);
		programShaders.remove(program);
	}

	/**
		Called after `linkProgram`.  Computes, for the program's vertex shader:

		  * `glLocation -> bgfx a_* slot`, using the GLSL name as the join key, and
		  * the uniform descriptor table (name, offset, member count, components,
		    sampler flag, texture unit).

		and hands both to `lime_metal_configure_program`.
	**/
	/** [cne-prog] CNE_METAL_PROGLOG=1: trace which programs actually get their uniform
	    tables configured.  A program that links without one keeps an empty uniform list,
	    so nothing is ever bound for it - an unbound sampler reads as black on Metal. */
	static function progLog(message:String):Void
	{
		#if cpp
		if (Sys.getEnv("CNE_METAL_PROGLOG") != null) Sys.println("[cne-prog] " + message);
		#end
	}

	public static function onLinkProgram(program:Int):Void
	{
		var shaders = programShaders.get(program);
		progLog("link program=" + program + " attachedShaders=" + (shaders == null ? "null" : Std.string(shaders.length)));
		if (shaders == null) return;

		var vertexResult:TranslateResult = null;
		for (shader in shaders)
		{
			var isVertex = shaderIsVertex.exists(shader) ? shaderIsVertex.get(shader) : false;
			if (isVertex && shaderResults.exists(shader))
			{
				vertexResult = shaderResults.get(shader);
				break;
			}
		}

		var attributeMap:Array<Dynamic> = [];
		if (vertexResult != null)
		{
			var locations = programAttributeLocations.get(program);

			// Lime's `lime_gl_get_attrib_location` only knows about names that were passed
			// to `glBindAttribLocation`; everything else comes back as -1, and OpenFL's
			// ShaderParameter does `if (index < 0) return;` - so those attributes are never
			// enabled and never get a vertex pointer.
			//
			// OpenFL only ever binds `openfl_Position`.  Relying on `attribute.index` (the
			// declaration order) for the rest collides with the explicit binding and, worse,
			// leaves the backend thinking those locations do not exist.  That is why every
			// draw carried a single attribute and every fragment ended up sampled from a
			// transparent atlas pixel.
			//
			// Assign a unique location to each attribute and push it back through
			// glBindAttribLocation, so glGetAttribLocation / GL_ACTIVE_ATTRIBUTES /
			// glGetActiveAttrib all agree and OpenFL feeds every attribute.
			var used = new Map<Int, Bool>();
			if (locations != null)
			{
				for (name in locations.keys())
				{
					used.set(locations.get(name), true);
				}
			}

			var nextFree = 0;
			for (attribute in vertexResult.attributes)
			{
				var glLocation = -1;

				if (locations != null && locations.exists(attribute.name))
				{
					glLocation = locations.get(attribute.name);
				}
				else
				{
					while (used.exists(nextFree)) nextFree++;
					glLocation = nextFree;
					used.set(glLocation, true);

					NativeCFFI.lime_gl_bind_attrib_location(program, glLocation, attribute.name);
				}

				attributeMap.push(glLocation);
				attributeMap.push(attribute.index);
			}
		}

		var uniformMap:Array<Dynamic> = [];
		for (shader in shaders)
		{
			if (!shaderResults.exists(shader)) continue;
			var result = shaderResults.get(shader);

			for (uniform in result.uniforms)
			{
				uniformMap.push(uniform.name);
				uniformMap.push(uniform.name);          // bgfx uniform name == GLSL name
				uniformMap.push(uniform.offset);
				uniformMap.push(uniform.memberCount);
				uniformMap.push(componentsOf(uniform.glslType));
				uniformMap.push(false);
				uniformMap.push(0);
			}

			for (sampler in result.samplers)
			{
				uniformMap.push(sampler.name);
				uniformMap.push(sampler.mslName);       // must match the MSL texture argument
				uniformMap.push(0);
				uniformMap.push(1);
				uniformMap.push(4);
				uniformMap.push(true);
				uniformMap.push(sampler.index);
			}
		}

		progLog("configure program=" + program + " attributes=" + (attributeMap.length / 2)
			+ " uniforms=" + (uniformMap.length / 7));

		NativeCFFI.lime_metal_configure_program(program, attributeMap, uniformMap);
	}

	/** Reports whether the backend really is running on Metal (for the startup log). */
	public static function isMetal():Bool
	{
		return NativeCFFI.lime_metal_is_metal() != 0;
	}

	static function componentsOf(glslType:String):Int
	{
		return switch (glslType)
		{
			case 'float', 'int', 'bool': 1;
			case 'vec2', 'ivec2', 'bvec2': 2;
			case 'vec3', 'ivec3', 'bvec3': 3;
			default: 4;
		};
	}
}
