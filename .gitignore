# ---- local-only / heavy artifacts (not part of the repo) ----
_local/
downloads/
app-backup-*/
*.log
*.tmp

# bgfx is an external dependency (see README §5.4); the build script creates these
bgfx-master/
bx
bimg

# ---- build outputs ----
CodenameEngine-1.0.1/export/
CodenameEngine-1.0.1/dump/
CodenameEngine-1.0.1/metal/generated/
CodenameEngine-1.0.1/export/release/
CodenameEngine-1.0.1/.haxelib/
CodenameEngine-1.0.1/.vscode/*.log

# ---- OS junk ----
.DS_Store
**/.DS_Store
# FLA/animate source art (152 MB) - not needed to build or run the game
CodenameEngine-1.0.1/art/flashFiles/


# Python bytecode
__pycache__/
*.pyc

# pixel-regression goldens (machine/driver specific) and artifacts
CodenameEngine-1.0.1/metal/autotests/golden/
CodenameEngine-1.0.1/metal/autotests/**/*.bmp

# ---- generated AOT shader cache (regenerated by metal/scripts/gen_shader_aot.py) ----
# Baked GLSL->MSL(+.metallib) data is build output, not source: it depends on the shaders
# present in assets/ + mods/ and on runtime-composed shader sources captured on this
# machine.  Committing it made stale/mismatched caches and hid mod shaders that were not
# baked yet.  apply.sh / make-universal.sh regenerate it before every build.
CodenameEngine-1.0.1/metal/haxe/lime/graphics/metal/ShaderAotCache.hx
CodenameEngine-1.0.1/source/lime/graphics/metal/ShaderAotCache.hx
CodenameEngine-1.0.1/metal/audit/aot-coverage.md
CodenameEngine-1.0.1/metal/audit/aot-coverage.zh.md
/deps/
/forks/
